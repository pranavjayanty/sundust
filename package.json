{
  "name": "sundust",
  "version": "0.1.0",
  "private": true,
  "description": "Mission control for the projects you run with a coding agent. Local-first, no account.",
  "type": "module",
  "bin": {
    "sundust": "./bin/sundust.js"
  },
  "scripts": {
    "start": "node bin/sundust.js up",
    "serve": "node bin/sundust.js serve",
    "daemon": "node bin/sundust.js daemon",
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pranavjayanty/sundust.git"
  },
  "homepage": "https://github.com/pranavjayanty/sundust",
  "keywords": [
    "claude-code",
    "coding-agent",
    "dashboard",
    "scheduler",
    "local-first"
  ]
}
